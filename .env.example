############################################################
# Example environment variables (do NOT commit real secrets)
# Copy this file to .env.local and fill in real values locally.
############################################################

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_API_BASE=https://your-backend.example.com
VITE_MCP_MODE=fallback

# Provider keys (prefer server-side proxies; keep public only if safe)
VITE_OPEN_AI_API_KEY=sk-openai-placeholder
VITE_ANTHROPIC_API_KEY=sk-anthropic-placeholder
VITE_OPENWEATHER_API_KEY=your-openweather-key

# NOTES:
# - VITE_API_BASE should point to your deployed Node/Express or Worker backend.
# - VITE_MCP_BASE optional if you connect directly to an MCP Worker separate from API_BASE.
# - Supabase anon key is public but ensure RLS policies protect data.

############################################################
# Server-side runtime (Node)
# Copy these into a project-root .env for the Node server.
############################################################

# Required: Anthropic API key for Claude (server-side only)
ANTHROPIC_API_KEY=

# Optional: default Anthropic model
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional: candidate fallback list (comma or space separated)
ANTHROPIC_MODEL_CANDIDATES=claude-3-5-sonnet, claude-3-5-sonnet-latest, claude-3-5-haiku, claude-3-5-haiku-latest, claude-3-opus, claude-3-opus-latest

# Allowed origins for CORS
ALLOWED_ORIGIN=http://localhost:5173
